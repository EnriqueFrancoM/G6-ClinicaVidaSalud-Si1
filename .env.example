; Copia este archivo como .env y completa tus datos locales.
APP_NAME="Clínica Vida Salud"
; URL hasta la carpeta public, por ejemplo con XAMPP:
APP_URL="http://localhost/G6-ClinicaVidaSalud-Si1/public"
APP_DEBUG=true

# En Render no se requieren las DB_*: el Blueprint entrega DATABASE_URL
# automáticamente desde PostgreSQL. Para ejecutar con una URL de PostgreSQL:
# DATABASE_URL="postgresql://usuario:clave@host:5432/bd_vidasalud"

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bd_vidasalud
DB_USER=postgres
DB_PASS=

; Clave para firmar los enlaces de confirmar/cancelar de los recordatorios (CU20).
; Genere una con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

; CU20: servidor SMTP para los recordatorios por correo. Si MAIL_HOST queda vacío,
; los recordatorios por correo quedan como FALLIDO (fallo controlado).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
; tls (STARTTLS), ssl o vacío
MAIL_ENCRYPTION=tls
