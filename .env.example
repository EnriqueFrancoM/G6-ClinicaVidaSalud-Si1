; Copia este archivo como .env y completa tus datos locales.
APP_NAME="Clínica Vida Salud"
; URL hasta la carpeta public, por ejemplo con XAMPP:
APP_URL="http://localhost/G6-ClinicaVidaSalud-Si1/public"
APP_DEBUG=true

# En Render no se requieren las DB_*: el Blueprint entrega DATABASE_URL
# automáticamente desde PostgreSQL. Para ejecutar con una URL de PostgreSQL:
# DATABASE_URL="postgresql://usuario:clave@host:5432/bd_vidasalud"

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bd_vidasalud
DB_USER=postgres
DB_PASS=

; Clave para firmar los enlaces de confirmar/cancelar de los recordatorios (CU20).
; Genere una con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

; CU20: servidor SMTP. Si MAIL_HOST tiene valor, se usa este servidor y se ignoran BREVO_SMTP_*.
; Vacío no envía correo y no simula un envío correcto.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
; tls (STARTTLS), ssl o vacío
MAIL_ENCRYPTION=tls

; Brevo. Elija una vía: relay SMTP o API REST. No ponga aquí claves reales del repositorio.
; SMTP: host smtp-relay.brevo.com, puerto 587, STARTTLS. El usuario es el login SMTP de Brevo
; y la clave es la clave SMTP (xsmtpsib-), distinta de la clave REST.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
; API REST (https://api.brevo.com/v3/smtp/email). Solo se usa si no hay MAIL_HOST ni BREVO_SMTP_*.
; Hacen falta la clave xkeysib- y un remitente verificado.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Clínica Vida Salud"

; Recordatorios: auto (WhatsApp si está configurado y hay teléfono; si no, correo; si no, portal),
; email o whatsapp. Un valor vacío o desconocido equivale a auto.
RECORDATORIO_CANAL=auto

; WhatsApp Cloud API. Sin WHATSAPP_TOKEN o sin WHATSAPP_PHONE_NUMBER_ID no se elige WhatsApp.
; El recordatorio sale 24 h antes, fuera de la ventana de atención: en producción hace falta
; una plantilla aprobada. Modo campos, variables del cuerpo en este orden:
; 1 paciente, 2 código, 3 especialidad, 4 médico, 5 fecha, 6 hora, 7 enlace confirmar, 8 enlace cancelar.
; Modo texto: la plantilla tiene un solo {{1}} y recibe el mensaje completo.
; Sin plantilla se intenta un texto libre; Meta puede rechazarlo y el recordatorio queda FALLIDO.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_IDIOMA=es
WHATSAPP_TEMPLATE_MODO=campos
; Prefijo si el teléfono del paciente tiene 8 dígitos o menos. Bolivia: 591.
WHATSAPP_PREFIJO=591

; Asistente de la clínica. Una sola clave para todas las cuentas. Vacía: el panel
; no llama al modelo y no simula una respuesta. La clave no se envía al navegador.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
